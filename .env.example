# Copia este archivo a .env (no se sube a git) para desarrollo local.
# En producción se usa .env.production con ambas variables vacías:
# el navegador llama al mismo origen y Nginx hace de proxy inverso.

# URL base del API Gateway. Las peticiones quedan como ${VITE_GATEWAY_URL}/api/...
# Vacía => rutas relativas (/api/...).
VITE_GATEWAY_URL=http://localhost:8080

# URL base del WebSocket del chat de soporte (ws:// o wss://). La conexión queda como ${VITE_COMMS_URL}/ws/support
# Vacía => se construye a partir de window.location (ws/wss según el protocolo de la página).
VITE_COMMS_URL=ws://localhost:8080
